# Degree Dean local development
# Copy to .env and adjust. Do not commit secrets.

# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=degree_dean
POSTGRES_USER=degreedean
POSTGRES_PASSWORD=degreedean_dev

# API
API_PORT=18428
APP_JWT_SECRET=change-me-to-a-64-char-random-string-for-local-dev-only-xxxx
APP_JWT_ACCESS_MINUTES=15
APP_JWT_REFRESH_DAYS=14
APP_CORS_ORIGINS=http://127.0.0.1:18427,http://localhost:18427

# Web
WEB_PORT=18427
VITE_API_BASE_URL=http://127.0.0.1:18428/api/v1

# Seed
APP_SEED_PATH=../../data/seed
APP_SEED_ON_STARTUP=true
